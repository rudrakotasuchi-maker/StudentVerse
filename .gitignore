# Root .gitignore for StudentVerse

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & Secrets
.env
*.env
backend/.env
!backend/.env.example

# Build Outputs
dist/
frontend/dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Scratch & Temporary
scratch/

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
